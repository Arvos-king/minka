# Minka — configuration du déploiement.
#
#   cp .env.example .env
#
# Ce fichier est un modèle versionné : le vrai `.env` ne doit jamais être
# committé (il est listé dans .gitignore). Son jumeau anglais,
# .env.example.en, porte les mêmes variables dans le même ordre : une variable
# ajoutée à l'un s'ajoute à l'autre.

# ---------------------------------------------------------------------------
# Réseau
# ---------------------------------------------------------------------------

# Port publié sur l'hôte unRAID. 8067, 8080, 8088 et 8090 sont déjà occupés
# par tes autres stacks. C'est ce port que Nginx Proxy Manager doit cibler.
APP_PORT=8070

TZ=Europe/Paris

# Utilisateur et groupe du processus dans le conteneur. 99:100 (nobody:users)
# est la convention unRAID pour appdata. Le dossier ./data doit lui appartenir :
#   mkdir -p data && chown -R 99:100 data
PUID=99
PGID=100

# ---------------------------------------------------------------------------
# Langue
# ---------------------------------------------------------------------------

# Langue de l'instance : fr ou en. Interface, messages, journaux et connecteur
# Claude la suivent. L'interface étant compilée dans cette langue, en changer
# demande de reconstruire : docker compose up -d --build
MINKA_LANG=fr

# Monnaie du budget, code ISO 4217 (EUR, GBP, USD…). Seules les monnaies à deux
# décimales sont acceptées : la compilation refuse les autres.
MINKA_CURRENCY=EUR

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------

# OBLIGATOIRE. Signe les jetons de session : quiconque le connaît peut forger
# une session. 32 caractères minimum, sinon l'API refuse de démarrer.
# Génère-le avec :   openssl rand -base64 48
SESSION_SECRET=

# `true` : le cookie de session n'est transmis qu'en HTTPS.
#
# ATTENTION — conséquence directe : avec `true`, la connexion NE FONCTIONNE PAS
# via http://IP_UNRAID:8070. Le navigateur refuse de stocker un cookie `Secure`
# reçu en clair. C'est voulu : l'accès nominal est le sous-domaine HTTPS servi
# par NPM (le service worker de la PWA exige HTTPS de toute façon).
# Passe temporairement à `false` uniquement pour un test en direct sur le LAN.
SESSION_COOKIE_SECURE=true

# Durée de validité d'une session, en jours. Le jeton est renouvelé
# automatiquement à chaque visite, donc pas de déconnexion sur mobile.
SESSION_LIFETIME_DAYS=30

# Nombre de proxies de confiance devant l'API : Nginx Proxy Manager (1) + le
# nginx de minka-web (2). Sert à retrouver la vraie IP du visiteur pour le
# rate-limit de la page de connexion.
# Si tu supprimes NPM et attaques directement le port 8070, passe à 1.
TRUST_PROXY=2

# ---------------------------------------------------------------------------
# Sauvegardes
# ---------------------------------------------------------------------------
#
# L'API se sauvegarde elle-même chaque nuit, et au démarrage s'il n'existe pas
# déjà une sauvegarde du jour. Rien à installer sur unRAID.

BACKUP_ENABLED=true

# Heure du passage nocturne (0-23), dans le fuseau défini par TZ.
BACKUP_HOUR=3

# Nombre de sauvegardes conservées ; les plus anciennes sont retirées.
BACKUP_KEEP=14

# Destination. Par défaut un sous-dossier de DATA_DIR, donc dans le même volume
# que la base : cela protège des fausses manœuvres, pas d'une panne de disque.
# Pour écrire vers un autre share, monter un second volume dans le service
# minka-api (voir docker-compose.yml) et pointer BACKUP_DIR dessus.
# BACKUP_DIR=/data/backups

# ---------------------------------------------------------------------------
# Connecteur Claude (facultatif)
# ---------------------------------------------------------------------------
#
# Laisse Claude lire le planning, les recettes et le frigo, et poser la semaine
# qu'on a préparée ensemble. Toutes vides : le connecteur reste éteint. À moitié
# remplies : l'API refuse de démarrer. Mise en service pas à pas dans le README,
# section « Mettre le connecteur en service ».

# Adresse publique du connecteur, telle qu'on la donne à Claude. C'est aussi
# l'identifiant de l'API « Minka » dans Pocket-ID, à la lettre près.
#   MCP_RESOURCE_URL=https://minka.cohen.tf/api/mcp
MCP_RESOURCE_URL=

# Adresse publique de Pocket-ID, qui délivre les jetons.
#   MCP_ISSUER=https://id.cohen.tf
MCP_ISSUER=

# La permission de l'API « Minka » dans Pocket-ID, que Claude doit obtenir.
# Vide comme les autres tant que le connecteur n'est pas mis en service : une
# seule variable renseignée suffit à faire refuser le démarrage.
#   MCP_PERMISSION=menus
MCP_PERMISSION=

# Qui a le droit d'entrer, et sous quel compte Minka :
# <identifiant Pocket-ID>=<compte>, séparés par des virgules. L'identifiant
# figure dans l'adresse de la fiche de la personne, dans l'administration de
# Pocket-ID ; à défaut, le journal de minka-api le donne à la première
# connexion refusée.
MCP_USERS=

# Facultative. Les clés de Pocket-ID par son adresse interne, si le conteneur ne
# joint pas l'adresse publique depuis le serveur lui-même :
#   MCP_JWKS_URL=http://IP_UNRAID:1411/.well-known/jwks.json
MCP_JWKS_URL=

# ---------------------------------------------------------------------------
# Comptes
# ---------------------------------------------------------------------------
#
# Créés automatiquement au démarrage s'ils n'existent pas déjà. Le seed ne
# réécrit JAMAIS un compte existant : changer un mot de passe ici après coup
# n'a aucun effet, il faut le faire depuis l'application.
#
# Tu peux ajouter d'autres comptes en continuant la numérotation
# (MINKA_USER3_USERNAME, etc.) : le code lit tous ceux qu'il trouve. Sous
# Docker, ajoute aussi leurs trois lignes au bloc `environment` de minka-api
# dans docker-compose.yml, qui ne transmet que les deux premiers.

MINKA_USER1_USERNAME=bastien
MINKA_USER1_PASSWORD=change-moi-avant-le-premier-demarrage
MINKA_USER1_NAME=Bastien

MINKA_USER2_USERNAME=
MINKA_USER2_PASSWORD=
MINKA_USER2_NAME=
