# Minka — deployment settings.
#
#   cp .env.example.en .env
#
# This file is a versioned template: the real `.env` must never be committed
# (it is listed in .gitignore). Its French twin, .env.example, has the same
# variables in the same order: a variable added to one belongs in the other.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Port published on the host. This is the port your reverse proxy forwards to.
APP_PORT=8070

TZ=Europe/London

# User and group of the process in the container. 99:100 is nobody:users, the
# unRAID convention; on another Linux host, your own user's ids (id -u, id -g)
# are often simpler. The ./data folder must belong to them:
#   mkdir -p data && chown -R 99:100 data
PUID=99
PGID=100

# ---------------------------------------------------------------------------
# Language
# ---------------------------------------------------------------------------

# Language of the instance: en or fr. The interface, the messages, the logs and
# the Claude connector follow it. The interface is compiled in this language,
# so changing it means rebuilding: docker compose up -d --build
MINKA_LANG=en

# Currency of the budget, as an ISO 4217 code (GBP, EUR, USD…). Only currencies
# with two decimal places are accepted: the build refuses the others.
MINKA_CURRENCY=GBP

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# REQUIRED. Signs the session tokens: anyone who knows it can forge a session.
# At least 32 characters, or the API refuses to start.
# Generate it with:   openssl rand -base64 48
SESSION_SECRET=

# `true`: the session cookie is only sent over HTTPS.
#
# Keep `true`: Minka is meant to be reached through your reverse proxy, over
# HTTPS (the app's service worker requires HTTPS anyway). The browser refuses a
# `Secure` cookie received over plain HTTP, so signing in through
# http://<server address>:8070 does not work. Set `false` only for a one-off
# test on your local network, then back to `true`: see README.en.md,
# "Plain HTTP".
SESSION_COOKIE_SECURE=true

# How long a session lasts, in days. The token is renewed automatically on
# each visit, so phones do not get signed out.
SESSION_LIFETIME_DAYS=30

# Number of trusted proxies in front of the API: your reverse proxy (1) + the
# nginx of minka-web (2). Used to find the visitor's real IP address for the
# sign-in rate limit. With nothing in front of minka-web: 1. With another proxy
# in front of yours, a CDN or a tunnel: 3.
TRUST_PROXY=2

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#
# The API backs itself up every night, and at startup if there is no backup
# from that day yet. Nothing to install.

BACKUP_ENABLED=true

# Hour of the nightly backup (0-23), in the TZ time zone.
BACKUP_HOUR=3

# Number of backups kept; the oldest are removed.
BACKUP_KEEP=14

# Destination. By default a subfolder of DATA_DIR, so on the same volume as the
# database: this protects against mistakes, not against a disk failure. To
# write elsewhere, mount a second volume in the minka-api service (see
# docker-compose.yml) and point BACKUP_DIR at it.
# BACKUP_DIR=/data/backups

# ---------------------------------------------------------------------------
# Claude connector (optional)
# ---------------------------------------------------------------------------
#
# Lets Claude read the meal plan, the recipes and the fridge, and plan the week
# you have prepared together. All empty: the connector stays off. Half filled
# in: the API refuses to start. Step-by-step setup in README.en.md, section
# "Claude connector".

# Public address of the connector, as given to Claude. It is also the audience
# expected in the tokens: the identifier of the "Minka" API in your identity
# provider, character for character.
#   MCP_RESOURCE_URL=https://minka.example.com/api/mcp
MCP_RESOURCE_URL=

# Public address of the OpenID Connect provider that issues the tokens (their
# `iss`).
#   MCP_ISSUER=https://id.example.com
MCP_ISSUER=

# The permission of the "Minka" API that Claude must obtain, found in the
# token's `scope`, `scp` or `permissions` claim. Optional, but leave it empty
# like the others until the connector is set up: a single variable filled in is
# enough for the API to refuse to start.
#   MCP_PERMISSION=menus
MCP_PERMISSION=

# Who may come in, and as which Minka account:
# <subject>=<username>, separated by commas. The subject is the person's user
# id at the identity provider (the `sub` of their tokens); failing that, the
# minka-api log prints it at the first refused sign-in.
MCP_USERS=

# Optional. The provider's signing keys (the `jwks_uri` of its discovery
# document) at an internal address, if the container cannot reach the public
# address from the server itself:
#   MCP_JWKS_URL=http://192.168.1.10:1411/.well-known/jwks.json
MCP_JWKS_URL=

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
#
# Created automatically at startup if they do not exist yet. An existing account
# is NEVER rewritten: changing a password here afterwards has no effect, it has
# to be done from the app. The password needs 8 characters at least; the name is
# the one shown in the app.
#
# You can add more accounts by continuing the numbering (MINKA_USER3_USERNAME,
# etc.): the code reads all it finds. With Docker, also add their three lines to
# the `environment` block of minka-api in docker-compose.yml, which only passes
# the first two on.

MINKA_USER1_USERNAME=
MINKA_USER1_PASSWORD=
MINKA_USER1_NAME=

MINKA_USER2_USERNAME=
MINKA_USER2_PASSWORD=
MINKA_USER2_NAME=
